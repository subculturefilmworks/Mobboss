{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mob Boss",
  "version": "0.1.0",
  "identifier": "org.mobboss.desktop",
  "build": {
    "beforeDevCommand": "node ../../scripts/fetch-ffmpeg.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node ../../scripts/fetch-ffmpeg.mjs && npm run build",
    "frontendDist": "../dist",
    "features": [
      "desktop"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "Mob Boss",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' blob: asset: http://asset.localhost; connect-src preview: http://preview.localhost ipc: http://ipc.localhost asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "MIT OR Apache-2.0",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "resources": {
      "../../../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../../../docs/licenses/": "licenses/"
    }
  }
}
